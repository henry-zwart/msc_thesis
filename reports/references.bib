@misc{wuSimulatingNodeManipulations2026,
  title = {Simulating {{Node Manipulations}} in {{Gaussian Graphical Models}}: {{The GGMNIRA Framework}} for {{Continuous}} and {{Ordinal Psychological Network Data}}},
  shorttitle = {Simulating {{Node Manipulations}} in {{Gaussian Graphical Models}}},
  author = {Wu, Yiming and Wang, Fei and Liu, Hongyun},
  year = 2026,
