@article{chambonHowComplianceBehavioural2023,
  title = {How Compliance with Behavioural Measures during the Initial Phase of a Pandemic Develops over Time: {{A}} Longitudinal {{COVID-19}} Study},
  shorttitle = {How Compliance with Behavioural Measures during the Initial Phase of a Pandemic Develops over Time},
  author = {Chambon, Monique and Dalege, Jonas and Borsboom, Denny and Waldorp, Lourens J. and {van der Maas}, Han L. J. and {van Harreveld}, Frenk},
  year = 2023,
  journal = {British Journal of Social Psychology},
