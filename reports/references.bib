@article{boutylineImprovingMeasurementShared2017,
  title = {Improving the {{Measurement}} of {{Shared Cultural Schemas}} with {{Correlational Class Analysis}}: {{Theory}} and {{Method}}},
  shorttitle = {Improving the {{Measurement}} of {{Shared Cultural Schemas}} with {{Correlational Class Analysis}}},
