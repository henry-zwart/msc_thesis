  shorttitle = {A {{Network Approach}} to {{Investigate}} the {{Dynamics}} of {{Individual}} and {{Collective Beliefs}}},
  author = {Vlasceanu, Madalina and Dyckovsky, Ari M. and Coman, Alin},
