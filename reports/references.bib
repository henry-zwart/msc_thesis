  keywords = {Condensed Matter - Statistical Mechanics,Physics - Physics and Society,Quantitative Biology - Neurons and Cognition},
  file = {/Users/henry/Zotero/storage/AIAPVFGE/Lee et al. - 2015 - Statistical mechanics of the US Supreme Court.pdf;/Users/henry/Zotero/storage/TCA5IHUM/1306.html}
}

