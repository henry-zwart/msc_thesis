			# $(THESIS_DIR)/results/data/model/all_interventions/sym_ising_10_yes_use_covariates.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_00_no_use_covariates.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_05_no_use_covariates.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_10_no_use_covariates.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_00_no_use_covariates.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_05_no_use_covariates.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_10_no_use_covariates.npz \
			| $(THESIS_DIR)/results/verification/model
	@uv run $<

$(THESIS_DIR)/results/verification/model: | $(THESIS_DIR)/results/verification
	@mkdir -p $@


$(THESIS_DIR)/results/verification: | $(THESIS_DIR)/results
	@mkdir -p $@

	

# === Analysis results/data
# +++ Section: Methods
$(THESIS_DIR)/results/data/methods/binarisation_sigma.json: \
			$(THESIS_DIR)/scripts/sec-methods/choose_sigma.py \
			| $(THESIS_DIR)/results/data/methods
	@uv run $<

$(THESIS_DIR)/results/data/methods/regularisation_sparsity.npz: \
			$(THESIS_DIR)/scripts/sec-methods/regularisation_sparsity_measure.py \
			| $(THESIS_DIR)/results/data/methods
	@uv run $<

$(THESIS_DIR)/results/data/methods: | $(THESIS_DIR)/results/data
	@mkdir -p $@

# +++ Section: Model
$(THESIS_DIR)/results/data/model/bootstrapped_fit/%.npz: \
			${PKG_PATH}/cli/analysis/fit_bootstrapped_models.py \
			$(THESIS_DIR)/results/data/model_fit/optimised_regularisation.json \
			${CA_BUILT_ASSETS}/reduced_no_imputation/metadata.json \
			| $(THESIS_DIR)/results/data/model/bootstrapped_fit
	@model=$$(uv run $(THESIS_DIR)/scripts/sec-model/fit_bootstrapped_parse_params.py $* model); \
	cov_flag=$$(uv run $(THESIS_DIR)/scripts/sec-model/fit_bootstrapped_parse_params.py $* cov_flag) && \
	uv run cadata analysis fit-bootstrapped \
		--output $@ \
		--model-type $$model \
		--seed 202606111547 \
		$$cov_flag \
		--repeats 1000 \
		--lam-path $(THESIS_DIR)/results/data/model_fit/optimised_regularisation.json \
		--sigma-path $(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
		$(QUIET_FLAG)
		

$(THESIS_DIR)/results/data/model/bootstrapped_fit: | $(THESIS_DIR)/results/data/model
	@mkdir -p $@
		
				
# Pairwise interventions: intervene on s_i, measure state at s_j at time t.
$(THESIS_DIR)/results/data/model/all_interventions: | $(THESIS_DIR)/results/data/model
	@mkdir -p $@

