$(THESIS_DIR)/results/figures/model/directional_differentials/rank_%.pdf: \
			$(THESIS_DIR)/results/data/model/bootstrapped_fit/ising_%.npz \
			${PKG_PATH}/cli/visualisation/directional_differential.py \
			| $(THESIS_DIR)/results/figures/model/directional_differentials
	uv run cadata plot directional-differentials \
		--bootstrap-models $< \
		--output $@ \
		--kind rank

$(THESIS_DIR)/results/figures/model/directional_differentials/pairwise_%.pdf: \
			$(THESIS_DIR)/results/data/model/bootstrapped_fit/ising_%.npz \
			${PKG_PATH}/cli/visualisation/directional_differential.py \
			| $(THESIS_DIR)/results/figures/model/directional_differentials
	uv run cadata plot directional-differentials \
		--bootstrap-models $< \
		--output $@ \
		--kind pairwise

$(THESIS_DIR)/results/figures/model/directional_differentials: | $(THESIS_DIR)/results/figures/model
	@mkdir -p $@

$(THESIS_DIR)/results/figures/model/interaction_matrix/%.pdf: \
			$(THESIS_DIR)/results/data/model/fit_%.npz \
			${PKG_PATH}/cli/visualisation/interaction_heatmap.py \
			| $(THESIS_DIR)/results/figures/model/interaction_matrix
	@model=$$(uv run $(THESIS_DIR)/scripts/sec-model/plot_interaction_heatmap_parse_params.py $* model) && \
	uv run cadata plot interaction-heatmap \
		--model $< \
		--output $@ \
		--model-type $$model

$(THESIS_DIR)/results/figures/model/interaction_matrix: | $(THESIS_DIR)/results/figures/model
	@mkdir -p $@

$(THESIS_DIR)/results/figures/model_fit/regularisation_ebic.pdf: \
			$(THESIS_DIR)/results/data/model_fit/asym_ising_regularisation_ebic.npz \
			$(THESIS_DIR)/results/data/model_fit/sym_ising_regularisation_ebic.npz \
			${PKG_PATH}/cli/visualisation/regularisation_ebic.py \
			| $(THESIS_DIR)/results/figures/model_fit
	uv run cadata plot regularisation-ebic \
		--asym-results $(THESIS_DIR)/results/data/model_fit/asym_ising_regularisation_ebic.npz \
		--sym-results $(THESIS_DIR)/results/data/model_fit/sym_ising_regularisation_ebic.npz \
		-z 1.96 \
		--output $@
			

# +++ Section: Dataset
$(THESIS_DIR)/results/figures/dataset/interresponse_times.pdf: \
			$(PKG_PATH)/cli/visualisation/interresponse_time.py \
			$(PKG_PATH)/visualisation.py \
			${CA_RAW_ASSETS}/w1w2w3w4w5_indices_weights_jul12_2022.parquet \
			${CA_RAW_ASSETS}/w6_cleaned_weights_june12_2023.parquet \
			| $(THESIS_DIR)/results/figures/dataset
	@uv run cadata plot interresponse-times --output $@


$(THESIS_DIR)/results/figures/dataset/response_eventplot.pdf: \
			$(PKG_PATH)/cli/visualisation/response_eventplot.py \
			$(PKG_PATH)/visualisation.py \
			${CA_RAW_ASSETS}/w1w2w3w4w5_indices_weights_jul12_2022.parquet \
			${CA_RAW_ASSETS}/w6_cleaned_weights_june12_2023.parquet \
			| $(THESIS_DIR)/results/figures/dataset
	@uv run cadata plot response-events --output $@


