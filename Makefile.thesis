# Pairwise interventions: intervene on s_i, measure state at s_j at time t.
$(THESIS_DIR)/results/data/model/all_interventions: | $(THESIS_DIR)/results/data/model
	@mkdir -p $@


$(THESIS_DIR)/results/data/model/all_interventions/%: \
			${PKG_PATH}/cli/analysis/all_interventions.py \
			$(THESIS_DIR)/results/data/model_fit/optimised_regularisation.json \
			$(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
			${CA_BUILT_ASSETS}/reduced_no_imputation/metadata.json \
			| $(THESIS_DIR)/results/data/model/all_interventions
	@model=$$(uv run $(THESIS_DIR)/scripts/sec-model/all_interventions_parse_params.py $* model); \
	delta=$$(uv run $(THESIS_DIR)/scripts/sec-model/all_interventions_parse_params.py $* delta) && \
	uv run cadata analysis all-interventions \
		--output $@ \
		--model-type "$$model" \
		--seed 202605271053 \
		--repeats 500 \
		--marginalise \
		--binarisation-kind "gaussian" \
		--measure-time 15 \
		--intervention-delta $$delta \
		--sigma-path $(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
		--lam-path $(THESIS_DIR)/results/data/model_fit/optimised_regularisation.json \
		$(QUIET_FLAG)

