			$(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
			| $(THESIS_DIR)/results/data/model_fit
	@model=$$(uv run $(THESIS_DIR)/scripts/sec-model-fit/regularisation_ebic_parse_params.py $*) && \
	uv run cadata analysis regularisation-ebic \
		--output $@ \
		--model-type $$model \
		--subset conservative \
		--min -2.5 \
		--max -1 \
		-n 30 \
		--repeats 1 \
		--marginalise \
		--binarisation-kind gaussian \
		--non-zero-threshold 0.01 \
		--sigma-path $(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
		--seed 202606191202 \
		$(QUIET_FLAG)

$(THESIS_DIR)/results/data/model_fit/%_regularisation_ebic_liberal.npz: \
			${PKG_PATH}/cli/analysis/regularisation.py \
			${CA_BUILT_ASSETS}/reduced_no_imputation/metadata.json \
			$(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
			| $(THESIS_DIR)/results/data/model_fit
	@model=$$(uv run $(THESIS_DIR)/scripts/sec-model-fit/regularisation_ebic_parse_params.py $*) && \
	uv run cadata analysis regularisation-ebic \
		--output $@ \
		--model-type $$model \
		--subset liberal \
		--min -2.5 \
		--max -1 \
		-n 30 \
		--repeats 1 \
		--marginalise \
		--binarisation-kind gaussian \
		--non-zero-threshold 0.01 \
		--sigma-path $(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
		--seed 202606191202 \
		$(QUIET_FLAG)



