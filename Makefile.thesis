# === Verification
# +++ Section: Model
# Pairwise interventions: intervene on s_i, measure state at s_j at time t.
$(THESIS_DIR)/results/verification/model/all_interventions.txt: \
			$(THESIS_DIR)/scripts/verification/model/all_interventions.py \
			# $(THESIS_DIR)/results/data/model/all_interventions/ising_00_yes_use_covariates.npz \
			# $(THESIS_DIR)/results/data/model/all_interventions/ising_05_yes_use_covariates.npz \
