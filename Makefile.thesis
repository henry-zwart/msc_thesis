		--full-sym-ebic-results $(THESIS_DIR)/results/data/model_fit/sym_ising_regularisation_ebic_full.npz \
		--conservative-asym-ebic-results $(THESIS_DIR)/results/data/model_fit/asym_ising_regularisation_ebic_conservative.npz \
		--liberal-asym-ebic-results $(THESIS_DIR)/results/data/model_fit/asym_ising_regularisation_ebic_liberal.npz
			

$(THESIS_DIR)/results/data/model_fit/%_regularisation_ebic_full.npz: \
			${PKG_PATH}/cli/analysis/regularisation.py \
			${CA_BUILT_ASSETS}/reduced_no_imputation/metadata.json \
			$(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
			| $(THESIS_DIR)/results/data/model_fit
	@model=$$(uv run $(THESIS_DIR)/scripts/sec-model-fit/regularisation_ebic_parse_params.py $*) && \
	uv run cadata analysis regularisation-ebic \
		--output $@ \
		--model-type $$model \
		--min -4 \
		--max -1.5 \
		-n 30 \
		--repeats 1 \
		--marginalise \
		--binarisation-kind gaussian \
		--non-zero-threshold 0.01 \
		--sigma-path $(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
		--seed 202606191202 \
		$(QUIET_FLAG)

$(THESIS_DIR)/results/data/model_fit/%_regularisation_ebic_conservative.npz: \
			${PKG_PATH}/cli/analysis/regularisation.py \
