# Timepoint at which to measure effect for all-intervention experiments 
MEASURE_TIME ?= 5

THESIS_DIR := reports/thesis
PKG_PATH := src/climate_attitudes

THESIS_DATA_DEPS := \
		$(THESIS_DIR)/results/data/dataset_metadata.json \
		$(THESIS_DIR)/results/data/model/bootstrapped_fit/ising_no_structure.npz \
		$(THESIS_DIR)/results/data/model/fit_full_sym_ising_no_structure.npz \
		$(THESIS_DIR)/results/data/model/fit_full_asym_ising_no_structure.npz \
		${CA_BUILT_ASSETS}/small_four_waves/metadata.json

THESIS_FIGURES_MODEL := \
		$(THESIS_DIR)/results/figures/methods/binarisation/distribution.pdf \
		$(THESIS_DIR)/results/figures/model/transition_probability_example.pdf \
		$(foreach d,05 10 15 25 80, \
			$(THESIS_DIR)/results/figures/model/intervention_effects/.$(d)_$(MEASURE_TIME)) \
		$(foreach d,05 10 15 25 80, \
			$(THESIS_DIR)/results/figures/model/intervention_collective_ranking/.$(d)_$(MEASURE_TIME)) \
		$(foreach d,05 10 15 25 80, \
			$(THESIS_DIR)/results/figures/model/intervention_collective_effect/.$(d)_$(MEASURE_TIME)) \
		$(foreach d,05 10 15 25 80, \
			$(THESIS_DIR)/results/figures/model/intervention_effect_distribution/.$(d)_$(MEASURE_TIME)) \
		$(THESIS_DIR)/results/figures/model/intervention_collective_ranking/.$(MEASURE_TIME) \
		$(THESIS_DIR)/results/figures/model/intervention_individual_ranking/.$(MEASURE_TIME) \
		$(THESIS_DIR)/results/figures/model/directional_differentials/ideology.pdf \
		$(THESIS_DIR)/results/figures/model/directional_differentials/rank_no_structure.pdf \
		$(THESIS_DIR)/results/figures/model/directional_differentials/pairwise_no_structure.pdf \
		$(THESIS_DIR)/results/figures/model/interaction_matrix/full_asym_ising_no_structure.pdf \
		$(THESIS_DIR)/results/figures/model/interaction_matrix/full_sym_ising_no_structure.pdf \
		$(THESIS_DIR)/results/figures/model/ideology_fit/conservative_interaction_matrix.pdf \
		$(THESIS_DIR)/results/figures/model/ideology_fit/liberal_interaction_matrix.pdf \
		$(THESIS_DIR)/results/figures/model/ideology_fit/network.pdf \
		$(THESIS_DIR)/results/figures/model/network.pdf \
		$(THESIS_DIR)/results/figures/model_fit/regularisation_ebic.pdf \
		$(THESIS_DIR)/results/figures/model/heterogeneous_effects/climate_policy_treedepth_3.pdf \
		$(THESIS_DIR)/results/figures/model/heterogeneous_effects/climate_policy_treedepth_4.pdf

THESIS_FIGURES_MODEL_CALIBRATION := \
		$(THESIS_DIR)/results/figures/model_fit/edge_accuracy.pdf \
		$(THESIS_DIR)/results/figures/model_fit/ideology_edge_accuracy.pdf \
		$(THESIS_DIR)/results/figures/model_fit/high_relative_entropy.pdf \
		$(THESIS_DIR)/results/figures/model_fit/selection_probability.pdf \
		$(THESIS_DIR)/results/figures/model_fit/transition_reliability.pdf \
		$(THESIS_DIR)/results/figures/model_fit/mean_relative_entropy.pdf \
		$(THESIS_DIR)/results/figures/model_fit/kl_difference_dist.pdf \
		$(THESIS_DIR)/results/figures/model_fit/kl_difference_examples.pdf \
		$(THESIS_DIR)/results/figures/model_fit/interaction_heatmap.pdf \
		$(THESIS_DIR)/results/figures/model_fit/ideology_interaction_heatmap.pdf

THESIS_FIGURES_METHODS := \
		$(THESIS_DIR)/results/figures/methods/intervention_strengths.pdf

THESIS_FIGURES_ASYMMETRY_RESULTS := \
		$(THESIS_DIR)/results/figures/asymmetry_results/effect_of_asymmetry_politics.pdf \
		$(THESIS_DIR)/results/figures/asymmetry_results/effect_of_asymmetry_cc_worry.pdf \
		$(THESIS_DIR)/results/figures/asymmetry_results/intervention_strength_compare.pdf \
		$(THESIS_DIR)/results/figures/asymmetry_results/outbound_effects_5.pdf \
		$(THESIS_DIR)/results/figures/asymmetry_results/outbound_effects_10.pdf \
		$(THESIS_DIR)/results/figures/asymmetry_results/outbound_effect_of_asymmetry.pdf \
		$(THESIS_DIR)/results/figures/asymmetry_results/inbound_effects.pdf
		

THESIS_FIGURES_DATASET := \
		$(THESIS_DIR)/results/figures/dataset/participation.pdf \
		$(THESIS_DIR)/results/figures/dataset/response_eventplot.pdf \
		$(THESIS_DIR)/results/figures/dataset/interresponse_times.pdf \
		$(THESIS_DIR)/results/figures/dataset/validation_switchpoints.pdf \
		$(THESIS_DIR)/results/figures/dataset/full_subset_partial_corr.pdf \
		$(THESIS_DIR)/results/figures/dataset/full_subset_var.pdf \
		$(THESIS_DIR)/results/figures/dataset/full_subset_dendrogram.pdf \
		$(THESIS_DIR)/results/figures/dataset/reduced_subset_partial_corr.pdf \
		$(THESIS_DIR)/results/figures/dataset/marginal_distributions.pdf \
		$(THESIS_DIR)/results/figures/dataset/likert_7_binarisation_probability.pdf \
		$(THESIS_DIR)/results/figures/dataset/transition_probability.pdf

THESIS_DIAGRAMS := \
		$(THESIS_DIR)/diagrams/modelling_interventions/intervention.svg \
		$(THESIS_DIR)/diagrams/modelling_interventions/intervention_baseline_activation.svg \
		$(THESIS_DIR)/diagrams/survey_database/database.svg

THESIS_FIGURES := \
		$(THESIS_FIGURES_MODEL) \
		$(THESIS_FIGURES_METHODS) \
		$(THESIS_FIGURES_MODEL_CALIBRATION) \
		$(THESIS_FIGURES_DATASET) \
		$(THESIS_FIGURES_ASYMMETRY_RESULTS) \
		$(THESIS_DIAGRAMS)
		#$(THESIS_FIGURES_MODEL_FIT_STRATIFICATION)



THESIS_VERIFICATION_FILES := \
		$(THESIS_DIR)/results/verification/model/all_interventions.txt \
		$(THESIS_DIR)/results/verification/model/all_interventions.txt

THESIS_TYPST_DEPS := \
		$(THESIS_DIR)/main.typ \
		$(THESIS_DIR)/sections/abstract.typ \
		$(THESIS_DIR)/sections/notation.typ \
		$(THESIS_DIR)/sections/introduction.typ \
		$(THESIS_DIR)/sections/asymmetric_belief_system.typ \
		$(THESIS_DIR)/sections/methods.typ \
		$(THESIS_DIR)/sections/calibration.typ \
		$(THESIS_DIR)/sections/asymmetry_results.typ \
		$(THESIS_DIR)/sections/heterogeneity_results.typ \
		$(THESIS_DIR)/sections/discussion.typ \
		$(THESIS_DIR)/sections/dataset.typ \
		$(THESIS_DIR)/sections/literature_review.typ \
		$(THESIS_DIR)/sections/conclusion.typ \
		$(THESIS_DIR)/references.bib


THESIS_DEPS := \
		$(THESIS_TYPST_DEPS) \
		$(THESIS_DATA_DEPS) \
		$(THESIS_FIGURES) \
		$(THESIS_VERIFICATION_FILES)

QUIET ?= 1
ifeq ($(QUIET),1)
	QUIET_FLAG := --quiet
else
	QUIET_FLAG := --no-quiet
endif

# ==== Report
outputs/reports/thesis.pdf: $(THESIS_DEPS)
	@echo ${TYPST_PACKAGE_PATH}
	@typst compile $(THESIS_DIR)/main.typ $@

# Results, figures, data
$(THESIS_DIR)/results/data/dataset_metadata.json: \
			$(PKG_PATH)/cli/info.py \
			${CA_RAW_ASSETS}/w1w2w3w4w5_indices_weights_jul12_2022.parquet \
			${CA_RAW_ASSETS}/w6_cleaned_weights_june12_2023.parquet \
			| $(THESIS_DIR)/results/data
	@uv run cadata info dataset --output $@

# === Figures
# +++ Section: Methods
$(THESIS_DIR)/results/figures/methods/binarisation/distribution.pdf: \
			$(THESIS_DIR)/scripts/sec-methods/binarisation_distribution.py \
			$(PKG_PATH)/visualisation.py \
			| $(THESIS_DIR)/results/figures/methods/binarisation
	@uv run $<

$(THESIS_DIR)/results/figures/methods/regularisation_sparsity.pdf: \
			$(THESIS_DIR)/scripts/sec-methods/regularisation_sparsity_plot.py \
			$(THESIS_DIR)/results/data/methods/regularisation_sparsity.npz \
			| $(THESIS_DIR)/results/figures/methods
	@uv run $<

$(THESIS_DIR)/results/figures/methods/binarisation: | $(THESIS_DIR)/results/figures/methods
	@mkdir -p $@

	

$(THESIS_DIR)/results/figures/methods: | $(THESIS_DIR)/results/figures
	@mkdir -p $@

# +++ Section: Methods
$(THESIS_DIR)/results/figures/methods/intervention_strengths.pdf: \
			$(THESIS_DIR)/scripts/sec-methods/intervention_strengths_diagram.py \
			$(PKG_PATH)/visualisation.py \
			| $(THESIS_DIR)/results/figures/methods
	@uv run $<

# +++ Model calibration
$(THESIS_DIR)/results/figures/model_fit/ideology_edge_accuracy.pdf: \
			$(THESIS_DIR)/scripts/sec-model/edge_accuracy_ideology.py \
			$(THESIS_DIR)/results/data/model/ideology_bootstrapped_fit/liberal.npz \
			$(THESIS_DIR)/results/data/model/ideology_bootstrapped_fit/conservative.npz \
			$(PKG_PATH)/visualisation.py \
			| $(THESIS_DIR)/results/figures/model_fit
	@uv run $<

$(THESIS_DIR)/results/figures/model_fit/edge_accuracy.pdf: \
			$(THESIS_DIR)/scripts/sec-model/edge_accuracy.py \
			$(THESIS_DIR)/results/data/model/bootstrapped_fit/ising_no_structure.npz \
			$(THESIS_DIR)/results/data/model/bootstrapped_fit/sym_ising_no_structure.npz \
			$(PKG_PATH)/visualisation.py \
			| $(THESIS_DIR)/results/figures/model_fit
	@uv run $<

$(THESIS_DIR)/results/figures/model_fit/selection_probability.pdf: \
			$(THESIS_DIR)/scripts/sec-model/selection_proportion.py \
			$(THESIS_DIR)/results/data/model/bootstrapped_fit/ising_no_structure.npz \
			$(THESIS_DIR)/results/data/model/bootstrapped_fit/sym_ising_no_structure.npz \
			$(PKG_PATH)/visualisation.py \
			| $(THESIS_DIR)/results/figures/model_fit
	@uv run $<

$(THESIS_DIR)/results/figures/model_fit/transition_reliability.pdf: \
			$(THESIS_DIR)/scripts/sec-calibration/transition_reliability.py \
			$(THESIS_DIR)/results/data/model_fit/optimised_regularisation.json \
			$(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
			${CA_BUILT_ASSETS}/reduced_no_imputation/metadata.json \
			$(PKG_PATH)/visualisation.py \
			| $(THESIS_DIR)/results/figures/model_fit
	@uv run $<

$(THESIS_DIR)/results/figures/model_fit/mean_relative_entropy.pdf: \
			$(THESIS_DIR)/scripts/sec-calibration/mean_relative_entropy.py \
			$(THESIS_DIR)/results/data/model_fit/optimised_regularisation.json \
			$(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
			${CA_BUILT_ASSETS}/reduced_no_imputation/metadata.json \
			$(PKG_PATH)/visualisation.py \
			| $(THESIS_DIR)/results/figures/model_fit
	@uv run $<

$(THESIS_DIR)/results/figures/model_fit/kl_difference_dist.pdf: \
			$(THESIS_DIR)/scripts/sec-calibration/difference_relative_entropy.py \
			$(THESIS_DIR)/results/data/model_fit/optimised_regularisation.json \
			$(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
			${CA_BUILT_ASSETS}/reduced_no_imputation/metadata.json \
			$(PKG_PATH)/visualisation.py \
			| $(THESIS_DIR)/results/figures/model_fit
	@uv run $<

$(THESIS_DIR)/results/figures/model_fit/kl_difference_examples.pdf: \
			$(THESIS_DIR)/scripts/sec-calibration/relative_entropy_difference_examples.py \
			$(THESIS_DIR)/results/data/model_fit/optimised_regularisation.json \
			$(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
			${CA_BUILT_ASSETS}/reduced_no_imputation/metadata.json \
			$(PKG_PATH)/visualisation.py \
			| $(THESIS_DIR)/results/figures/model_fit
	@uv run $<

$(THESIS_DIR)/results/figures/model_fit/interaction_heatmap.pdf: \
			$(THESIS_DIR)/scripts/sec-calibration/interaction_heatmaps.py \
			$(THESIS_DIR)/results/data/model/fit_full_asym_ising_no_structure.npz \
			$(THESIS_DIR)/results/data/model/fit_full_sym_ising_no_structure.npz \
			$(PKG_PATH)/visualisation.py \
			| $(THESIS_DIR)/results/figures/model_fit
	@uv run $<

$(THESIS_DIR)/results/figures/model_fit/ideology_interaction_heatmap.pdf: \
			$(THESIS_DIR)/scripts/sec-calibration/ideology_interaction_heatmaps.py \
			$(THESIS_DIR)/results/data/model/ideology_fit_conservative.npz \
			$(THESIS_DIR)/results/data/model/ideology_fit_liberal.npz \
			$(PKG_PATH)/visualisation.py \
			| $(THESIS_DIR)/results/figures/model_fit
	@uv run $<

$(THESIS_DIR)/results/figures/model_fit/high_relative_entropy.pdf: \
			$(THESIS_DIR)/scripts/sec-model/relative_entropy.py \
			$(THESIS_DIR)/results/data/model_fit/optimised_regularisation.json \
			$(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
			${CA_BUILT_ASSETS}/reduced_no_imputation/metadata.json \
			$(PKG_PATH)/visualisation.py \
			| $(THESIS_DIR)/results/figures/model_fit
	@uv run $<

# +++ Section: Asymmetry results
$(THESIS_DIR)/results/figures/asymmetry_results/effect_of_asymmetry_politics.pdf: \
			$(THESIS_DIR)/scripts/sec-asymmetry-results/effect_of_asymmetry_politics.py \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_00.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_05.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_10.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_25.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_00.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_05.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_10.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_25.npz \
			$(PKG_PATH)/visualisation.py \
			| $(THESIS_DIR)/results/figures/asymmetry_results
	@uv run $<

$(THESIS_DIR)/results/figures/asymmetry_results/effect_of_asymmetry_cc_worry.pdf: \
			$(THESIS_DIR)/scripts/sec-asymmetry-results/effect_of_asymmetry_cc_worry.py \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_00.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_05.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_10.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_25.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_00.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_05.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_10.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_25.npz \
			$(PKG_PATH)/visualisation.py \
			| $(THESIS_DIR)/results/figures/asymmetry_results
	@uv run $<

$(THESIS_DIR)/results/figures/asymmetry_results/outbound_effects_%.pdf: \
			$(PKG_PATH)/cli/visualisation/compare_outbound_int_effect.py \
			$(PKG_PATH)/visualisation.py \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_00.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_25.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_00.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_25.npz \
			| $(THESIS_DIR)/results/figures/asymmetry_results
	uv run cadata plot compare-outbound-effects \
		--output-dir $(@D) \
		--data-dir $(THESIS_DIR)/results/data/model/all_interventions \
		--point-of-intervention-idx 4 \
		--point-of-intervention-idx 2 \
		--point-of-intervention-idx 5 \
		--delta 2.5 \
		-z 1.96 \
		--measure-time $*

$(THESIS_DIR)/results/figures/asymmetry_results/inbound_effects.pdf: \
			$(THESIS_DIR)/scripts/sec-asymmetry-results/inbound_effects.py \
			$(PKG_PATH)/visualisation.py \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_00.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_25.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_00.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_25.npz \
			| $(THESIS_DIR)/results/figures/asymmetry_results
	@uv run $<
	

$(THESIS_DIR)/results/figures/asymmetry_results/outbound_effect_of_asymmetry.pdf: \
			$(THESIS_DIR)/scripts/sec-asymmetry-results/outbound_effect_of_asymmetry.py \
			$(PKG_PATH)/visualisation.py \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_00.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_25.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_00.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_25.npz \
			| $(THESIS_DIR)/results/figures/asymmetry_results
	@uv run $<

$(THESIS_DIR)/results/figures/asymmetry_results/intervention_strength_compare.pdf: \
			$(PKG_PATH)/cli/visualisation/intervention_strength_relationship.py \
			$(PKG_PATH)/visualisation.py \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_00.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_05.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_25.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_00.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_05.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_25.npz \
			| $(THESIS_DIR)/results/figures/model/intervention_effects
	uv run cadata plot compare-intervention-strengths \
		--output-dir $(@D) \
		--data-dir $(THESIS_DIR)/results/data/model/all_interventions \
		--point-of-intervention-idx 0 \
		--point-of-intervention-idx 2 \
		--point-of-intervention-idx 5 \
		--delta 0.5 \
		--delta 2.5 \
		-z 1.96 \
		--measure-time $(MEASURE_TIME)

$(THESIS_DIR)/results/figures/asymmetry_results: | $(THESIS_DIR)/results/figures
	@mkdir -p $@

# +++ Section: Model
$(THESIS_DIR)/results/figures/model/transition_probability_example.pdf: \
			$(THESIS_DIR)/scripts/sec-model/transition_prob_example.py \
			$(PKG_PATH)/visualisation.py \
			| $(THESIS_DIR)/results/figures/model
	@uv run $<

$(THESIS_DIR)/results/figures/model/ideology_fit/%_interaction_matrix.pdf: \
			$(THESIS_DIR)/results/data/model/ideology_fit_%.npz \
			${PKG_PATH}/cli/visualisation/interaction_heatmap.py \
			| $(THESIS_DIR)/results/figures/model/ideology_fit
	@uv run cadata plot interaction-heatmap \
		--model $< \
		--output $@ \
		--model-type ising

$(THESIS_DIR)/results/figures/model/ideology_fit/network.pdf: \
			$(THESIS_DIR)/results/data/model/ideology_fit_conservative.npz \
			$(THESIS_DIR)/results/data/model/ideology_fit_liberal.npz \
			${PKG_PATH}/cli/visualisation/ideology_network.py \
			| $(THESIS_DIR)/results/figures/model/ideology_fit
	@uv run cadata plot ideology-networks \
		--conservative-model $(THESIS_DIR)/results/data/model/ideology_fit_conservative.npz \
		--liberal-model $(THESIS_DIR)/results/data/model/ideology_fit_liberal.npz \
		--output $@ \
		--model-type ising \
		--seed 20260623

$(THESIS_DIR)/results/figures/model/network.pdf: \
			$(THESIS_DIR)/results/data/model/fit_full_asym_ising_no_structure.npz \
			$(THESIS_DIR)/results/data/model/fit_full_sym_ising_no_structure.npz \
			${PKG_PATH}/cli/visualisation/network.py \
			| $(THESIS_DIR)/results/figures/model/network
	uv run cadata plot network \
		--sym-model $(THESIS_DIR)/results/data/model/fit_full_sym_ising_no_structure.npz \
		--asym-model $(THESIS_DIR)/results/data/model/fit_full_asym_ising_no_structure.npz \
		--output $@ \
		--seed 20260623

$(THESIS_DIR)/results/figures/model/network: | $(THESIS_DIR)/results/figures/model
	@mkdir -p $@


$(THESIS_DIR)/results/figures/model/ideology_fit: | $(THESIS_DIR)/results/figures/model
	@mkdir -p $@

$(THESIS_DIR)/results/figures/model/intervention_effects: | $(THESIS_DIR)/results/figures/model
	@mkdir -p $@


$(THESIS_DIR)/results/figures/model/intervention_effects/.%_$(MEASURE_TIME): \
			$(PKG_PATH)/cli/visualisation/intervention_mean_int_effect.py \
			$(PKG_PATH)/visualisation.py \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_00.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_%.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_00.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_%.npz \
			| $(THESIS_DIR)/results/figures/model/intervention_effects
	uv run cadata plot intervention-mean-effects \
		--output-dir $(@D) \
		--data-dir $(THESIS_DIR)/results/data/model/all_interventions \
		--delta-str $* \
		-z 1.96 \
		--measure-time $(MEASURE_TIME) && \
	touch $@

$(THESIS_DIR)/results/figures/model/intervention_collective_ranking: | $(THESIS_DIR)/results/figures/model
	mkdir -p $@


$(THESIS_DIR)/results/figures/model/intervention_collective_ranking/.%_$(MEASURE_TIME): \
			$(PKG_PATH)/cli/visualisation/intervention_mean_collective_ranking.py \
			$(PKG_PATH)/visualisation.py \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_%.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_%.npz \
			| $(THESIS_DIR)/results/figures/model/intervention_collective_ranking
	uv run cadata plot intervention-mean-collective-rank \
		--output-dir $(@D) \
		--data-dir $(THESIS_DIR)/results/data/model/all_interventions \
		--delta-str $* \
		-z 1.96 \
		--measure-time $(MEASURE_TIME) && \
	touch $@

$(THESIS_DIR)/results/figures/model/intervention_collective_ranking/.$(MEASURE_TIME): \
			$(PKG_PATH)/cli/visualisation/intervention_mean_collective_ranking_comb.py \
			$(PKG_PATH)/visualisation.py \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_05.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_25.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_05.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_25.npz \
