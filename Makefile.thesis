#.SECONDARY:

# Timepoint at which to measure effect for all-intervention experiments 
MEASURE_TIME ?= 4

THESIS_DIR := reports/thesis
PKG_PATH := src/climate_attitudes

THESIS_DATA_DEPS := $(THESIS_DIR)/results/data/dataset_metadata.json

THESIS_FIGURES_MODEL := \
		$(THESIS_DIR)/results/figures/methods/binarisation/distribution.pdf \
		$(THESIS_DIR)/results/figures/model/transition_probability_example.pdf \
		$(foreach d,05 10 15 25 80, \
			$(THESIS_DIR)/results/figures/model/intervention_effects/.$(d)_$(MEASURE_TIME)_no_use_covariates) \
		$(foreach d,05 10 15 25 80, \
			$(THESIS_DIR)/results/figures/model/intervention_collective_ranking/.$(d)_$(MEASURE_TIME)_no_use_covariates) \
		$(foreach d,05 10 15 25 80, \
			$(THESIS_DIR)/results/figures/model/intervention_collective_effect/.$(d)_$(MEASURE_TIME)_no_use_covariates) \
		$(foreach d,05 10 15 25 80, \
			$(THESIS_DIR)/results/figures/model/intervention_effect_distribution/.$(d)_$(MEASURE_TIME)_no_use_covariates) \
		$(THESIS_DIR)/results/figures/model/directional_differentials/rank_no_use_covariates_no_structure.pdf \
		$(THESIS_DIR)/results/figures/model/directional_differentials/pairwise_no_use_covariates_no_structure.pdf \
		$(THESIS_DIR)/results/figures/model/interaction_matrix/full_asym_ising_no_structure.pdf \
		$(THESIS_DIR)/results/figures/model/interaction_matrix/full_sym_ising_no_structure.pdf \
		$(THESIS_DIR)/results/figures/model/interaction_matrix/dem_male_0_asym_ising_no_structure.pdf \
		$(THESIS_DIR)/results/figures/model/interaction_matrix/dem_male_1_asym_ising_no_structure.pdf \
		$(THESIS_DIR)/results/figures/model/interaction_matrix/dem_urban_0_asym_ising_no_structure.pdf \
		$(THESIS_DIR)/results/figures/model/interaction_matrix/dem_urban_1_asym_ising_no_structure.pdf \
		$(THESIS_DIR)/results/figures/model/interaction_matrix/dem_urban_2_asym_ising_no_structure.pdf \
		$(THESIS_DIR)/results/figures/model_fit/regularisation_ebic.pdf
		# $(foreach d,05 10 15 25 80, $(foreach cf,yes_use_covariates no_use_covariates, \
		# 	$(THESIS_DIR)/results/figures/model/intervention_effects/.$(d)_$(MEASURE_TIME)_$(cf))) \
		# $(foreach d,05 10 15 25 80, $(foreach cf,yes_use_covariates no_use_covariates, \
		# 	$(THESIS_DIR)/results/figures/model/intervention_collective_ranking/.$(d)_$(MEASURE_TIME)_$(cf))) \
		# $(foreach d,05 10 15 25 80, $(foreach cf,yes_use_covariates no_use_covariates, \
		# 	$(THESIS_DIR)/results/figures/model/intervention_collective_effect/.$(d)_$(MEASURE_TIME)_$(cf))) \
		# $(foreach d,05 10 15 25 80, $(foreach cf,yes_use_covariates no_use_covariates, \
		# 	$(THESIS_DIR)/results/figures/model/intervention_effect_distribution/.$(d)_$(MEASURE_TIME)_$(cf))) \
		#$(THESIS_DIR)/results/figures/model/directional_differentials/rank_yes_use_covariates_no_structure.pdf \
		#$(THESIS_DIR)/results/figures/model/directional_differentials/pairwise_yes_use_covariates_no_structure.pdf \
		#$(THESIS_DIR)/results/figures/model/interaction_matrix/ising_yes_use_covariates_no_structure.pdf \
		#$(THESIS_DIR)/results/figures/model/interaction_matrix/sym_ising_yes_use_covariates_no_structure.pdf \
		

THESIS_FIGURES_DATASET := \
		$(THESIS_DIR)/results/figures/dataset/response_eventplot.pdf \
		$(THESIS_DIR)/results/figures/dataset/interresponse_times.pdf

# THESIS_FIGURES_MODEL_FIT_STRATIFICATION := \
# 		$(THESIS_DIR)/results/figures/model_fit/stratification_sym_ising_male.pdf \
# 		$(THESIS_DIR)/results/figures/model_fit/stratification_sym_ising_educ.pdf \
# 		$(THESIS_DIR)/results/figures/model_fit/stratification_sym_ising_income_percep.pdf \
# 		$(THESIS_DIR)/results/figures/model_fit/stratification_sym_ising_urban.pdf \
# 		$(THESIS_DIR)/results/figures/model_fit/stratification_ising_male.pdf \
# 		$(THESIS_DIR)/results/figures/model_fit/stratification_ising_educ.pdf \
# 		$(THESIS_DIR)/results/figures/model_fit/stratification_ising_income_percep.pdf \
# 		$(THESIS_DIR)/results/figures/model_fit/stratification_ising_urban.pdf

THESIS_FIGURES := \
		$(THESIS_FIGURES_MODEL) \
		$(THESIS_FIGURES_DATASET)
		#$(THESIS_FIGURES_MODEL_FIT_STRATIFICATION)

THESIS_VERIFICATION_FILES := \
		$(THESIS_DIR)/results/verification/model/all_interventions.txt \
		$(THESIS_DIR)/results/verification/model/all_interventions.txt

THESIS_TYPST_DEPS := \
		$(THESIS_DIR)/main.typ \
		$(THESIS_DIR)/sections/abstract.typ \
		$(THESIS_DIR)/sections/dataset.typ \
		$(THESIS_DIR)/sections/model.typ


THESIS_DEPS := \
		$(THESIS_TYPST_DEPS) \
		$(THESIS_DATA_DEPS) \
		$(THESIS_FIGURES) \
		$(THESIS_VERIFICATION_FILES)

QUIET ?= 1
ifeq ($(QUIET),1)
	QUIET_FLAG := --quiet
else
	QUIET_FLAG := --no-quiet
endif

# ==== Report
outputs/reports/thesis.pdf: $(THESIS_DEPS)
	@echo ${TYPST_PACKAGE_PATH}
	@typst compile $(THESIS_DIR)/main.typ $@

# Results, figures, data
$(THESIS_DIR)/results/data/dataset_metadata.json: \
			$(PKG_PATH)/cli/info.py \
			${CA_RAW_ASSETS}/w1w2w3w4w5_indices_weights_jul12_2022.parquet \
			${CA_RAW_ASSETS}/w6_cleaned_weights_june12_2023.parquet \
			| $(THESIS_DIR)/results/data
	@uv run cadata info dataset --output $@

# === Figures
# +++ Section: Methods
$(THESIS_DIR)/results/figures/methods/binarisation/distribution.pdf: \
			$(THESIS_DIR)/scripts/sec-methods/binarisation_distribution.py \
			$(PKG_PATH)/visualisation.py \
			| $(THESIS_DIR)/results/figures/methods/binarisation
	@uv run $<

$(THESIS_DIR)/results/figures/methods/regularisation_sparsity.pdf: \
			$(THESIS_DIR)/scripts/sec-methods/regularisation_sparsity_plot.py \
			$(THESIS_DIR)/results/data/methods/regularisation_sparsity.npz \
			| $(THESIS_DIR)/results/figures/methods
	@uv run $<

$(THESIS_DIR)/results/figures/methods/binarisation: | $(THESIS_DIR)/results/figures/methods
	@mkdir -p $@

	

$(THESIS_DIR)/results/figures/methods: | $(THESIS_DIR)/results/figures
	@mkdir -p $@


# +++ Section: Model
$(THESIS_DIR)/results/figures/model/transition_probability_example.pdf: \
			$(THESIS_DIR)/scripts/sec-model/transition_prob_example.py \
			$(PKG_PATH)/visualisation.py \
			| $(THESIS_DIR)/results/figures/model
	@uv run $<

