# 	$(THESIS_DIR)/results/data/model/all_interventions/%/measure.npy
#
# $(THESIS_DIR)/results/data/model/all_interventions/%/params.npy: \
# 	$(THESIS_DIR)/results/data/model/all_interventions/%/measure.npy
#
# $(THESIS_DIR)/results/data/model/all_interventions/%/check.npy: \
# 	$(THESIS_DIR)/results/data/model/all_interventions/%/measure.npy

$(THESIS_DIR)/results/data/model/all_interventions/%: \
			${PKG_PATH}/cli/analysis/all_interventions.py \
			$(THESIS_DIR)/results/data/model_fit/optimised_regularisation.json \
			$(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
			${CA_BUILT_ASSETS}/reduced_no_imputation/metadata.json \
			| $(THESIS_DIR)/results/data/model/all_interventions
	@model=$$(uv run $(THESIS_DIR)/scripts/sec-model/all_interventions_parse_params.py $* model); \
	delta=$$(uv run $(THESIS_DIR)/scripts/sec-model/all_interventions_parse_params.py $* delta); \
	cov_flag=$$(uv run $(THESIS_DIR)/scripts/sec-model/all_interventions_parse_params.py $* cov_flag) && \
	uv run cadata analysis all-interventions \
		--output $@ \
		--model-type "$$model" \
		--seed 202605271053 \
		$$cov_flag \
		--repeats 30 \
		--measure-time 6 \
		--intervention-delta $$delta \
		--sigma-path $(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
		--lam-path $(THESIS_DIR)/results/data/model_fit/optimised_regularisation.json \
		$(QUIET_FLAG)
		#--adjacency adj_policies_as_sink.npy \


$(THESIS_DIR)/results/data/model/fit_%.npz: \
			${PKG_PATH}/cli/analysis/fit_model.py \
			$(THESIS_DIR)/results/data/model_fit/optimised_regularisation.json \
			$(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
			${CA_BUILT_ASSETS}/reduced_no_imputation/metadata.json \
			| $(THESIS_DIR)/results/data/model
	@filter_cond=$$(uv run $(THESIS_DIR)/scripts/sec-model/fit_model_parse_params.py $* filter); \
	model=$$(uv run $(THESIS_DIR)/scripts/sec-model/fit_model_parse_params.py $* model) && \
	uv run cadata analysis fit-model \
		--output $@ \
		--model-type $$model \
		$$filter_cond \
		--lam-path $(THESIS_DIR)/results/data/model_fit/optimised_regularisation.json \
		--sigma-path $(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
		--seed 202606181614

$(THESIS_DIR)/results/data/model_fit/optimised_regularisation.json: \
			${PKG_PATH}/cli/analysis/choose_regularisation_strength.py \
			$(THESIS_DIR)/results/data/model_fit/asym_ising_regularisation_ebic.npz \
			$(THESIS_DIR)/results/data/model_fit/sym_ising_regularisation_ebic.npz \
			| $(THESIS_DIR)/results/data/model_fit
	uv run cadata analysis choose-regularisation \
		--output $@ \
		--asym-ebic-results $(THESIS_DIR)/results/data/model_fit/asym_ising_regularisation_ebic.npz \
		--sym-ebic-results $(THESIS_DIR)/results/data/model_fit/sym_ising_regularisation_ebic.npz
			

$(THESIS_DIR)/results/data/model_fit/%_regularisation_ebic.npz: \
			${PKG_PATH}/cli/analysis/regularisation.py \
			${CA_BUILT_ASSETS}/reduced_no_imputation/metadata.json \
			$(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
			| $(THESIS_DIR)/results/data/model_fit
	@model=$$(uv run $(THESIS_DIR)/scripts/sec-model-fit/regularisation_ebic_parse_params.py $*) && \
	uv run cadata analysis regularisation-ebic \
		--output $@ \
		--model-type $$model \
		--min -4 \
		--max -1.8 \
		-n 30 \
		--repeats 100 \
		--non-zero-threshold 0.01 \
		--sigma-path $(THESIS_DIR)/results/data/methods/binarisation_sigma.json \
		--seed 202606191202 \
		$(QUIET_FLAG)



$(THESIS_DIR)/results/data: | $(THESIS_DIR)/results
	@mkdir -p $@

$(THESIS_DIR)/results/data/model: | $(THESIS_DIR)/results/data
	@mkdir -p $@

$(THESIS_DIR)/results/data/model_fit: | $(THESIS_DIR)/results/data
	@mkdir -p $@

$(THESIS_DIR)/results/figures/model: | $(THESIS_DIR)/results/figures
	@mkdir -p $@

$(THESIS_DIR)/results/figures/dataset: | $(THESIS_DIR)/results/figures
	@mkdir -p $@

$(THESIS_DIR)/results/figures/model_fit: | $(THESIS_DIR)/results/figures
	@mkdir -p $@

$(THESIS_DIR)/results/figures: | $(THESIS_DIR)/results
	@mkdir -p $@

$(THESIS_DIR)/results: 
	@mkdir -p $(THESIS_DIR)/results

