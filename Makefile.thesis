$(THESIS_DIR)/results/figures/model/intervention_effects/.%_$(MEASURE_TIME)_no_use_covariates: \
			$(PKG_PATH)/cli/visualisation/intervention_mean_int_effect.py \
			$(PKG_PATH)/visualisation.py \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_00_no_use_covariates.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/ising_%_no_use_covariates.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_00_no_use_covariates.npz \
			$(THESIS_DIR)/results/data/model/all_interventions/sym_ising_%_no_use_covariates.npz \
			| $(THESIS_DIR)/results/figures/model/intervention_effects
	uv run cadata plot intervention-mean-effects \
		--output-dir $(@D) \
		--data-dir $(THESIS_DIR)/results/data/model/all_interventions \
		--delta-str $* \
		--no-use-covariates \
		--measure-time $(MEASURE_TIME) \
		--seed 202606051229 && \
	touch $@

