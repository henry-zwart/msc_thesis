	@mkdir -p $@

$(THESIS_DIR)/results/figures/dataset: | $(THESIS_DIR)/results/figures
	@mkdir -p $@

$(THESIS_DIR)/results/figures/model_fit: | $(THESIS_DIR)/results/figures
	@mkdir -p $@

$(THESIS_DIR)/results/figures: | $(THESIS_DIR)/results
	@mkdir -p $@

