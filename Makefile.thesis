			$(THESIS_DIR)/results/data/model/all_interventions/%.npz \
			${PKG_PATH}/cli/analysis/calculate_activation_probability.py \
			| $(THESIS_DIR)/results/data/model/all_interventions_activation_probability
	delta=$$(uv run $(THESIS_DIR)/scripts/sec-model/all_interventions_parse_params.py $*.npz delta) && \
	uv run cadata analysis calculate-activation-probability \
		--simulation-results $< \
		--intervention-delta $$delta \
		--measure-time 5 \
		--output $@

$(THESIS_DIR)/results/data/model/all_interventions_activation_probability: $(THESIS_DIR)/results/data/model
